#!/usr/bin/env bash
# mail-domain — manage Postfix webhook transport domains.
# All state lives in /opt/zoner-mail/ (nothing in /etc/postfix except
# the master.cf block + postconf keys, see install-mail-server.sh).
set -euo pipefail

DIR="/opt/zoner-mail"
FILE="$DIR/transport"
LOCK="$DIR/.lock"

[[ $EUID -eq 0 ]] || { echo "Run with sudo" >&2; exit 1; }

validate() {
  [[ "$1" =~ ^([a-z0-9](-?[a-z0-9])*\.)+[a-z]{2,}$ ]] || {
    echo "Invalid domain: $1" >&2
    exit 1
  }
}

# Serialize concurrent runs (agent + manual)
exec 9>"$LOCK"
flock 9

reload_postfix() {
  # systemd nếu có, fallback service/sysv (container)
  systemctl reload postfix 2>/dev/null || service postfix reload 2>/dev/null || postfix reload
}

sync_postfix() {
  postmap "$FILE"
  local domains
  domains="$(awk '$2=="webhook:" {print $1}' "$FILE" | sort -u | paste -sd, -)"
  postconf -e "relay_domains = $domains"
  postfix check
  reload_postfix
}

cmd_add() {
  local domain="${1,,}"
  domain="${domain%.}"
  validate "$domain"
  touch "$FILE"
  grep -Fqx "$domain    webhook:" "$FILE" && { echo "Already exists: $domain"; exit 0; }
  printf '%s    webhook:\n' "$domain" >> "$FILE"
  sync_postfix
  echo "Added: $domain"
}

cmd_remove() {
  local domain="${1,,}"
  domain="${domain%.}"
  validate "$domain"
  local tmp
  tmp="$(mktemp)"
  awk -v d="$domain" '!($1==d && $2=="webhook:")' "$FILE" > "$tmp"
  cat "$tmp" > "$FILE"
  rm -f "$tmp"
  sync_postfix
  echo "Removed: $domain"
}

cmd_list() {
  [[ -f "$FILE" ]] || exit 0
  awk '$2=="webhook:" {print $1}' "$FILE" | sort -u
}

case "${1:-}" in
  add)        [[ -n "${2:-}" ]] || exit 1; cmd_add "$2" ;;
  remove|rm)  [[ -n "${2:-}" ]] || exit 1; cmd_remove "$2" ;;
  list|ls)    cmd_list ;;
  *)
    echo "Usage: mail-domain add DOMAIN | remove DOMAIN | list" >&2
    exit 1
    ;;
esac
