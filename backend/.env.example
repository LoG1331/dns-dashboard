# ---- Server ----
PORT=5001
# Listen address: specific IP or 0.0.0.0 (all interfaces)
HOST=0.0.0.0
# Serve frontend build from the same port (production)
SERVE_FRONTEND=false

# ---- Single admin account (seeded on first start) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Admin

# ---- Security ----
# openssl rand -base64 32
JWT_SECRET=changeme

# PowerDNS API URL / API key / nameservers / zone kind / secondaries
# are configured from the Settings page (stored in the DB, not env).
